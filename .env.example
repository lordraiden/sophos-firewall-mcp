# Sophos Firewall Configuration REST API — connection settings
#
# Prerequisites on the appliance (Administration):
#   1. API access enabled, and this client's source IP in "Allowed IP hosts".
#   2. HTTPS / Web Admin Console enabled for the administrator's source zone under Device access.
#      From the WAN zone the only documented mechanism is a Local service ACL exception rule
#      scoped to specific source IPs (never Any / 0.0.0.0).
#   3. A dedicated least-privilege administrator (None / Read-only / Read-write per feature) that
#      generated the API key. Keys expire after one year and rotation is manual.
#
# The API key is a Bearer token. Use exactly one of SOPHOS_API_KEY or SOPHOS_API_KEY_FILE.

# Firewall hostname or IP address only: no scheme, port, user information, path or query.
SOPHOS_HOST=192.168.1.1

# HTTPS port of the Web Admin Console (SFOS default: 4444).
SOPHOS_PORT=4444

# Option A (development): the API key inline. Set exactly one of the two options.
SOPHOS_API_KEY=your_api_key_here

# Option B (preferred for containers): a mounted secret file; the value is read and stripped.
# SOPHOS_API_KEY_FILE=/run/secrets/sophos_api_key

# TLS verification is on by default. Set to false ONLY for a lab appliance with a self-signed
# certificate; prefer SOPHOS_CA_BUNDLE with the appliance/private CA instead.
SOPHOS_VERIFY_SSL=true

# Optional PEM CA bundle used to verify a private or self-signed appliance certificate.
# SOPHOS_CA_BUNDLE=/etc/ssl/certs/sophos-ca.pem

# Request timeout in seconds (connect, read, write and pool).
SOPHOS_TIMEOUT=30

# Maximum concurrent HTTP requests to the appliance (1-64). Bounds the shared client so a
# burst of tool calls cannot exhaust the appliance or the connection pool.
SOPHOS_MAX_CONCURRENCY=4

# Environment proxy variables (HTTP_PROXY / HTTPS_PROXY / ALL_PROXY) are deliberately NOT used:
# the Bearer token must never travel through an inherited proxy. Route traffic at the host level.

# When true, mutation tools are not registered at all. This is an extra defence only: effective
# authorization still comes from the Sophos administrator profile behind the API key.
SOPHOS_READ_ONLY_MODE=false
